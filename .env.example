# ─── LLM backend (OpenAI-compatible, localhost:8889) ─────────────────────────
# Works with either:
#   mlx_lm.server --model mlx-community/Meta-Llama-3.1-8B-Instruct-4bit --port 8889
#   llama-server -m <gguf> --alias mlx-community/Meta-Llama-3.1-8B-Instruct-4bit \
#                --port 8889 --jinja
OPENAI_API_KEY=not-needed
OPENAI_BASE_URL=http://localhost:8889/v1
OPENAI_MODEL=mlx-community/Meta-Llama-3.1-8B-Instruct-4bit

# ─── Weather provider ────────────────────────────────────────────────────────
# open-meteo (default, no key) | openweathermap
WEATHER_PROVIDER=open-meteo
# OPENWEATHER_API_KEY=replace-me

# ─── HTTP ────────────────────────────────────────────────────────────────────
REQUEST_TIMEOUT_S=15.0